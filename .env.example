# Database - Render provides this automatically when you add a PostgreSQL database
# Format: postgresql://user:password@host:port/database
DATABASE_URL=

# Payment provider (LipaWin)
LIPAWIN_API_KEY=your_api_key_here
LIPAWIN_BUSINESS_ID=your_business_id

# CORS - set to your Render URL (e.g., https://forex-trading.onrender.com)
ALLOWED_ORIGIN=*

# Node environment
NODE_ENV=development