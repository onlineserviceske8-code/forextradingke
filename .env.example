# Database - Render provides this automatically when you add a PostgreSQL database
# Format: postgresql://user:password@host:port/database
DATABASE_URL=

# Payment provider (Paywave Xpress)
PAYWAVE_API_KEY=your_api_key_here
PAYWAVE_EMAIL=your_email@example.com

# CORS - set to your Render URL (e.g., https://forex-trading.onrender.com)
ALLOWED_ORIGIN=*

# Node environment
NODE_ENV=development